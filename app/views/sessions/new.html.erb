<div class="min-h-screen flex items-center justify-center bg-shell p-5">
  <div class="w-full max-w-[392px] bg-surface rounded-phone p-6 flex flex-col gap-6">
    <div>
      <div class="text-[21px] font-bold">साइन इन</div>
      <div class="text-[17px] text-ink-3">आफ्नो नाम र PIN छान्नुहोस्</div>
    </div>

    <% if flash[:alert] %>
      <div class="px-4 py-3 rounded-ctl bg-stop-50 border-2 border-stop text-stop text-[17px] font-semibold">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with url: session_path, method: :post, class: "flex flex-col gap-5" do |f| %>
      <div class="flex flex-col gap-2">
        <%= f.label :user_id, "प्रयोगकर्ता", class: "text-[17px] font-semibold" %>
        <%= f.select :user_id, Current.shop.users.active.order(:name).pluck(:name, :id),
              {}, class: "min-h-[64px] px-4 rounded-ctl border-2 border-line-2 bg-card text-[19px]" %>
      </div>

      <div class="flex flex-col gap-2">
        <%= f.label :pin, "PIN", class: "text-[17px] font-semibold" %>
        <%= f.password_field :pin, inputmode: "numeric", maxlength: 4,
              class: "min-h-[64px] px-4 rounded-ctl border-2 border-line-2 bg-card text-[28px] font-mono tracking-[0.5em] text-center" %>
      </div>

      <%= f.submit "साइन इन गर्नुहोस्",
            class: "min-h-[70px] px-4 py-2.5 rounded-tile text-[21px] font-bold leading-[1.35] bg-go text-surface active:bg-go-700" %>
    <% end %>
  </div>
</div>
