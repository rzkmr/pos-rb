<h1>Sign in</h1>

<% if flash[:alert] %>
  <p><%= flash[:alert] %></p>
<% end %>

<%= form_with url: session_path, method: :post do |f| %>
  <div>
    <%= f.label :user_id, "User" %>
    <%= f.select :user_id, Current.shop.users.active.order(:name).pluck(:name, :id) %>
  </div>
  <div>
    <%= f.label :pin, "PIN" %>
    <%= f.password_field :pin, inputmode: "numeric", maxlength: 4 %>
  </div>
  <%= f.submit "Sign in" %>
<% end %>
