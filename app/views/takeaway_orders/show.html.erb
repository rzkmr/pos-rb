<div class="min-h-screen bg-shell flex flex-col" data-controller="order-cart"
     data-order-cart-table-session-id-value="<%= @table_session.id %>"
     data-order-cart-submit-url-value="<%= tickets_path %>">

  <header class="bg-go text-[#f2f7f4] px-4 py-3.5">
    <div class="flex items-center justify-between">
      <div class="text-[24px] font-bold"><%= @dining_table.label %></div>
      <div class="text-[16px] opacity-85 flex items-center gap-2">
        <%= link_to "← #{t('.all_tables')}", dining_tables_path, class: "underline" %>
        <%= link_to "EN", locale_path(locale: "en"), data: { turbo_method: :patch },
              class: "px-2.5 py-1.5 rounded-key text-[13px] font-bold bg-wall-3 active:bg-key-2" %>
        <%= link_to "ने", locale_path(locale: "ne"), data: { turbo_method: :patch },
              class: "px-2.5 py-1.5 rounded-key text-[13px] font-bold bg-wall-3 active:bg-key-2" %>
      </div>
    </div>
  </header>

  <div id="pending-banner" data-order-cart-target="pendingBanner"
       class="flex items-center gap-2.5 px-4 py-3 bg-warn text-warn-900 border-b-[3px] border-warn-700" hidden>
    <span class="w-3.5 h-3.5 rounded-full bg-[#7a5300] animate-pulse"></span>
    <span class="text-[17px] font-bold">
      <span data-order-cart-target="pendingCount"></span> <%= t(".sending_orders") %>
    </span>
  </div>

  <% if @table_session.status == "open" %>
    <section class="flex-1 flex flex-col overflow-hidden">
      <div class="px-3.5 pt-3.5">
        <h2 class="text-[17px] font-semibold text-ink-2 mb-1"><%= t(".menu") %></h2>
      </div>
      <div class="grid grid-cols-2 gap-2.5 p-3.5 overflow-y-auto">
        <% @menu_items.group_by(&:category).each do |category, items| %>
          <div class="col-span-2 text-[18px] font-bold text-ink-2 mt-2 first:mt-0"><%= category.titleize %></div>
          <% items.each do |menu_item| %>
            <button type="button"
                    data-action="order-cart#add"
                    data-order-cart-menu-item-id-param="<%= menu_item.id %>"
                    data-order-cart-menu-item-name-param="<%= menu_item.name %>"
                    data-order-cart-menu-item-price-param="<%= menu_item.price_paise %>"
                    class="min-h-[104px] p-3 rounded-tile bg-card border-2 border-line
                           flex flex-col justify-between items-start text-left gap-1.5
                           active:border-go active:bg-go-50">
              <span class="text-[20px] font-semibold leading-[1.35]"><%= menu_item.name %></span>
              <span class="w-full flex items-center justify-between">
                <span class="text-[18px] font-mono text-ink-2"><%= money_to_inr(menu_item.price_paise) %></span>
              </span>
            </button>
          <% end %>
        <% end %>
      </div>
    </section>

    <section class="border-t border-line bg-surface px-3.5 py-3">
      <h2 class="text-[17px] font-semibold text-ink-2 mb-2"><%= t(".cart") %></h2>
      <p data-order-cart-target="empty" class="text-[16px] text-ink-3"><%= t(".cart_empty") %></p>
      <ul data-order-cart-target="list" class="flex flex-col gap-1.5 mb-3"></ul>
      <button type="button" data-action="order-cart#submit" data-order-cart-target="submit" disabled
              class="w-full min-h-[70px] px-4 py-2.5 rounded-tile text-[21px] font-bold leading-[1.35]
                     bg-go text-surface active:bg-go-700
                     disabled:bg-key-2 disabled:text-ink-4">
        <%= t(".add_to_order") %>
      </button>
    </section>
  <% end %>

  <% if @tickets.any? || @table_session.status != "open" %>
    <div class="p-4 flex flex-col gap-4 max-w-[640px] mx-auto w-full">
      <section class="bg-card rounded-tile border border-line p-4">
        <h2 class="text-[17px] font-semibold text-ink-2 mb-2"><%= t(".items") %></h2>
        <ul class="flex flex-col gap-2">
          <% @tickets.each do |ticket| %>
            <% ticket.ticket_items.active.each do |item| %>
              <li class="flex items-center justify-between gap-3 py-2 border-b border-line last:border-0">
                <span class="text-[19px] flex-1">
                  <span class="font-mono text-ink-2"><%= item.quantity %> ×</span> <%= item.name_snapshot %>
                </span>
                <span class="w-[120px] text-right font-mono text-[18px]"><%= money_to_inr(item.quantity * item.unit_price_paise) %></span>
                <% if @table_session.status == "open" %>
                  <%= form_with url: void_ticket_item_path(item), method: :patch, class: "flex items-center gap-1.5" do %>
                    <%= text_field_tag :reason, nil, placeholder: t("shared.reason"), required: true,
                          class: "min-h-[40px] w-20 px-2 rounded-key border border-line-2 text-[14px]" %>
                    <%= submit_tag t(".void"), class: "min-h-[40px] px-2.5 rounded-key text-[14px] font-bold border-[2px] border-stop text-stop active:bg-stop-50" %>
                  <% end %>
                <% end %>
              </li>
            <% end %>
          <% end %>
        </ul>
      </section>

      <section class="bg-card rounded-tile border border-line p-5">
        <div class="text-[22px] font-semibold"><%= t(".total_with_tax") %></div>
        <div class="text-[34px] font-mono font-bold"><%= money_to_inr(@billing.total_paise) %></div>

        <div class="mt-3 flex flex-col gap-1 text-[16px] text-ink-3">
          <div class="flex justify-between"><span><%= t(".subtotal") %></span><span class="font-mono"><%= money_to_inr(@billing.taxable_paise) %></span></div>
          <% if Current.shop.composition_scheme %>
            <div class="text-[14px] italic"><%= t(".composition_declaration") %></div>
          <% else %>
            <div class="flex justify-between"><span><%= t(".cgst") %></span><span class="font-mono"><%= money_to_inr(@billing.cgst_paise) %></span></div>
            <div class="flex justify-between"><span><%= t(".sgst") %></span><span class="font-mono"><%= money_to_inr(@billing.sgst_paise) %></span></div>
          <% end %>
          <div class="flex justify-between"><span><%= t(".round_off") %></span><span class="font-mono"><%= money_to_inr(@billing.round_off_paise) %></span></div>
        </div>
      </section>

      <% if @table_session.status == "open" %>
        <section class="rounded-tile border-2 border-go bg-go-50 p-4">
          <div class="text-[20px] font-bold">
            <% remaining = @billing.total_paise - @table_session.paid_paise %>
            <% if remaining <= 0 %>
              <%= t(".fully_paid") %>
            <% else %>
              <%= t(".remaining", amount: money_to_inr(remaining)) %>
            <% end %>
          </div>

          <%= form_with url: table_session_payments_path(@table_session), method: :post, class: "mt-3 flex flex-col gap-2.5" do %>
            <%= select_tag "payment[method]", options_for_select(Payment::METHODS),
                  class: "min-h-[56px] px-3 rounded-ctl border-2 border-line-2 text-[18px]" %>
            <%= text_field_tag "payment[amount_paise]", nil, placeholder: t(".amount_paise_placeholder"),
                  class: "min-h-[56px] px-3 rounded-ctl border-2 border-line-2 font-mono text-[19px]" %>
            <%= text_field_tag "payment[reference]", nil, placeholder: t(".reference_placeholder"),
                  class: "min-h-[56px] px-3 rounded-ctl border-2 border-line-2 text-[19px]" %>
            <%= submit_tag t(".take_payment"), class: "min-h-[84px] rounded-tile text-[20px] font-bold border-[2.5px] border-ink bg-card active:bg-key" %>
          <% end %>
        </section>
      <% else %>
        <div class="text-center text-[16px] text-ink-3"><%= t(".session_status", status: @table_session.status) %></div>

        <% if @invoice %>
          <section class="bg-card rounded-tile border border-line p-4">
            <h2 class="text-[18px] font-bold mb-1"><%= t(".invoice_number", number: @invoice.number) %></h2>
            <% latest_print_job = @invoice.print_jobs.order(:created_at).last %>
            <% if latest_print_job %>
              <p class="text-[15px] text-ink-3"><%= t(".print_status", status: latest_print_job.status) %></p>
              <% if latest_print_job.status == "failed" %>
                <p class="mt-1 px-3 py-2 rounded-ctl bg-stop-50 border-2 border-stop text-stop text-[15px] font-semibold">
                  <%= t(".print_failed", error: latest_print_job.last_error) %>
                </p>
              <% end %>
            <% end %>
            <%= button_to t(".print_receipt"), reprint_invoice_path(@invoice), method: :post,
                  class: "mt-3 w-full min-h-[70px] rounded-tile text-[20px] font-bold bg-go text-surface active:bg-go-700" %>
          </section>

          <%= link_to t(".new_order"), takeaway_path,
                class: "text-center min-h-[64px] flex items-center justify-center rounded-tile text-[19px] font-bold bg-key text-ink active:bg-key-2" %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
