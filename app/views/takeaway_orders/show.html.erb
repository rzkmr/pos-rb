<% if @table_session.status == "open" %>
  <%# Counter shell — full-bleed on phone, a centered card on md: up (design_system §8.1).
      Same tokens as every other screen; only the layout shape is specific to this one. %>
  <div class="bg-shell"
       data-controller="takeaway-checkout"
       data-takeaway-checkout-table-session-id-value="<%= @table_session.id %>"
       data-takeaway-checkout-checkout-url-value="<%= takeaway_checkouts_path %>"
       data-takeaway-checkout-dining-table-id-value="<%= @dining_table.id %>"
       data-takeaway-checkout-held-carts-url-value="<%= dining_table_held_carts_path(@dining_table) %>"
       data-takeaway-checkout-gst-rate-bp-value="<%= Current.shop.gst_rate_bp %>"
       data-takeaway-checkout-composition-scheme-value="<%= Current.shop.composition_scheme %>">

    <%# status toast — hold/restore confirmations, top-centered, no action button %>
    <div data-takeaway-checkout-target="toast"
         class="fixed left-1/2 -translate-x-1/2 top-4 z-[60] px-4 py-3 rounded-tile bg-ink text-surface
                text-[15px] font-semibold shadow-lg transition-opacity duration-200 opacity-0" hidden></div>

    <div class="h-[100dvh] md:h-[820px] md:max-h-[85vh] w-full bg-shell flex flex-col md:flex-row overflow-hidden">

      <%# ── catalogue column ─────────────────────────────────────── %>
      <div class="flex-1 min-w-0 flex flex-col overflow-hidden">
        <header class="shrink-0 flex items-center justify-between gap-3 px-4 pt-[max(1rem,env(safe-area-inset-top))] pb-2">
          <div class="min-w-0">
            <h1 class="text-[19px] font-bold leading-tight truncate"><%= @dining_table.label %></h1>
            <p class="text-[13px] text-ink-3 font-mono mt-0.5" data-takeaway-checkout-target="clock"></p>
          </div>
          <div class="flex items-center gap-1.5 shrink-0">
            <button type="button" data-action="takeaway-checkout#hold" title="<%= t(".hold") %>"
                    class="w-9 h-9 rounded-key bg-card border border-line-2 flex items-center justify-center text-ink-3 active:text-ink active:bg-key">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12C22 17.5228 17.5228 22 12 22ZM12 20C16.4183 20 20 16.4183 20 12C20 7.58172 16.4183 4 12 4C7.58172 4 4 7.58172 4 12C4 16.4183 7.58172 20 12 20ZM9 9H11V15H9V9ZM13 9H15V15H13V9Z"></path></svg>
            </button>
            <button type="button" data-action="takeaway-checkout#showHeld" title="<%= t(".held_orders") %>"
                    class="relative w-9 h-9 rounded-key bg-card border border-line-2 flex items-center justify-center text-ink-3 active:text-ink active:bg-key">
             <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M20.0833 15.1999L21.2854 15.9212C21.5221 16.0633 21.5989 16.3704 21.4569 16.6072C21.4146 16.6776 21.3557 16.7365 21.2854 16.7787L12.5144 22.0412C12.1977 22.2313 11.8021 22.2313 11.4854 22.0412L2.71451 16.7787C2.47772 16.6366 2.40093 16.3295 2.54301 16.0927C2.58523 16.0223 2.64413 15.9634 2.71451 15.9212L3.9166 15.1999L11.9999 20.0499L20.0833 15.1999ZM20.0833 10.4999L21.2854 11.2212C21.5221 11.3633 21.5989 11.6704 21.4569 11.9072C21.4146 11.9776 21.3557 12.0365 21.2854 12.0787L11.9999 17.6499L2.71451 12.0787C2.47772 11.9366 2.40093 11.6295 2.54301 11.3927C2.58523 11.3223 2.64413 11.2634 2.71451 11.2212L3.9166 10.4999L11.9999 15.3499L20.0833 10.4999ZM12.5144 1.30864L21.2854 6.5712C21.5221 6.71327 21.5989 7.0204 21.4569 7.25719C21.4146 7.32757 21.3557 7.38647 21.2854 7.42869L11.9999 12.9999L2.71451 7.42869C2.47772 7.28662 2.40093 6.97949 2.54301 6.7427C2.58523 6.67232 2.64413 6.61343 2.71451 6.5712L11.4854 1.30864C11.8021 1.11864 12.1977 1.11864 12.5144 1.30864ZM11.9999 3.33233L5.88723 6.99995L11.9999 10.6676L18.1126 6.99995L11.9999 3.33233Z"></path></svg>
              <span data-takeaway-checkout-target="heldBadge"
                    class="absolute -top-1.5 -right-1.5 min-w-[18px] h-[18px] px-1 rounded-full bg-warn text-warn-900
                           text-[11px] font-bold flex items-center justify-center leading-none" hidden></span>
            </button>
          </div>
        </header>

        <div class="shrink-0 px-4 pb-1.5">
          <%= link_to "← #{t('.all_tables')}", dining_tables_path, class: "text-[13px] text-ink-3 underline" %>
        </div>

        <div data-takeaway-checkout-target="charging"
             class="shrink-0 flex items-center gap-2.5 px-4 py-3 bg-warn text-warn-900 border-y-[3px] border-warn-700" hidden>
          <span class="w-3.5 h-3.5 rounded-full bg-[#7a5300] animate-pulse shrink-0"></span>
          <span class="text-[15px] font-bold"><%= t(".charging") %></span>
        </div>

        <%# search %>
        <div class="shrink-0 px-4 pb-3">
          <div class="flex items-center bg-card border border-line-2 rounded-ctl px-3 gap-2 focus-within:border-go transition-colors">
            <span class="text-ink-3 text-[16px]">⌕</span>
            <input type="text" inputmode="search" placeholder="<%= t(".search_placeholder") %>"
                   data-takeaway-checkout-target="search" data-action="input->takeaway-checkout#filterItems"
                   class="flex-1 bg-transparent border-none outline-none text-[16px] py-2.5 placeholder:text-ink-3">
            <button type="button" data-action="takeaway-checkout#clearSearch" data-takeaway-checkout-target="searchClear"
                    class="text-ink-3 text-[14px] font-bold" hidden>✕</button>
          </div>
        </div>

        <%# category chips — pill-shaped (design_system §8.1) %>
        <nav class="shrink-0 overflow-x-auto [-webkit-overflow-scrolling:touch]" style="scrollbar-width: none;">
          <div class="flex gap-2 px-4 pb-3 w-max snap-x">
            <% @menu_items.group_by(&:category).keys.each_with_index do |category, index| %>
              <button type="button" data-action="takeaway-checkout#jumpToCategory" data-takeaway-checkout-category-param="<%= category %>"
                      data-takeaway-checkout-target="categoryTab"
                      class="snap-start shrink-0 min-h-[44px] px-4 rounded-full border text-[14px] font-bold whitespace-nowrap
                             <%= index.zero? ? 'bg-ink border-ink text-surface' : 'bg-card border-line-2 text-ink-3' %>">
                <%= t("table_sessions.show.category_#{category}", default: category.titleize) %>
              </button>
            <% end %>
          </div>
        </nav>

        <%# item grid %>
        <section class="flex-1 overflow-y-auto pb-24 md:pb-3" data-takeaway-checkout-target="itemList">
          <% @menu_items.group_by(&:category).each do |category, items| %>
            <div data-takeaway-checkout-category-section="<%= category %>" class="scroll-mt-2">
              <div class="sticky top-0 z-10 px-4 py-2 bg-shell/95 backdrop-blur-sm text-[13px] font-bold tracking-wide text-ink-3 uppercase">
                <%= t("table_sessions.show.category_#{category}", default: category.titleize) %>
              </div>
              <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 px-4 pb-3">
                <% items.each do |menu_item| %>
                  <button type="button"
                          data-action="takeaway-checkout#add"
                          data-takeaway-checkout-menu-item-id-param="<%= menu_item.id %>"
                          data-takeaway-checkout-menu-item-name-param="<%= menu_item.name %>"
                          data-takeaway-checkout-menu-item-price-param="<%= menu_item.price_paise %>"
                          data-takeaway-checkout-target="itemRow"
                          data-takeaway-checkout-item-id="<%= menu_item.id %>"
                          class="pcard-fill relative min-h-[124px] p-3 rounded-tile bg-card border border-line overflow-hidden
                                 flex flex-col justify-between items-start text-left gap-1.5
                                 active:scale-[.97] transition-transform">
                    <span class="absolute top-0 left-0 right-0 h-[3px] bg-go"></span>
                    <span class="absolute top-2.5 right-2.5 min-w-[22px] h-[22px] px-1.5 rounded-full bg-go text-surface
                                 text-[12px] font-bold font-mono flex items-center justify-center leading-none
                                 opacity-0 scale-0 transition-all duration-200" data-takeaway-checkout-target="rowQty"></span>
                    <span class="text-[17px] font-semibold leading-[1.3] pr-6"><%= menu_item.name %></span>
                    <span class="text-[15px] font-mono text-ink-2"><%= money_to_inr(menu_item.price_paise) %></span>
                  </button>
                <% end %>
              </div>
            </div>
          <% end %>
          <div data-takeaway-checkout-target="noSearchResults" class="px-4 py-14 text-center text-ink-3" hidden>
            <div class="text-[32px] mb-2">⌕</div>
            <p class="text-[15px]"><%= t(".no_search_results") %></p>
          </div>
        </section>
      </div>
      <%# ── /catalogue column ────────────────────────────────────── %>

      <%# ── cart sidebar — desktop/tablet only, permanent, own header/footer ───── %>
      <aside class="hidden md:flex md:w-[380px] md:shrink-0 md:border-l md:border-line md:flex-col md:bg-surface">
        <div class="shrink-0 flex items-center justify-between px-4 pt-4 pb-3 border-b border-line">
          <h2 class="text-[17px] font-bold"><%= t("table_sessions.show.cart") %></h2>
          <button type="button" data-action="takeaway-checkout#clearCart"
                  class="text-[13px] font-semibold text-ink-3 active:text-stop">
            <%= t(".clear") %>
          </button>
        </div>
        <div class="flex-1 overflow-y-auto px-4 py-3 flex flex-col gap-2" data-takeaway-checkout-target="cartListDesktop"></div>
        <div class="shrink-0 border-t border-line p-4" data-takeaway-checkout-target="cartFooterDesktop"></div>
      </aside>
    </div>

    <%# ── mobile bottom bar — total + View Cart (design_system §8, adapted mobile) ───── %>
    <div data-takeaway-checkout-target="mobileBar"
         class="md:hidden fixed bottom-0 left-0 right-0 z-30 h-[72px] bg-surface border-t border-line
                flex items-center justify-between px-4 pb-[env(safe-area-inset-bottom)]" hidden>
      <div>
        <p class="text-[12px] text-ink-3 font-semibold uppercase tracking-wide"><%= t("shared.total") %></p>
        <p class="text-[20px] font-mono font-bold" data-takeaway-checkout-target="mobileTotal"></p>
      </div>
      <button type="button" data-action="takeaway-checkout#openCart"
              class="min-h-[52px] px-6 rounded-tile bg-go text-surface text-[15px] font-bold active:bg-go-700">
        <span data-takeaway-checkout-target="mobileCartLabel"></span>
      </button>
    </div>

    <%# ── mobile cart FAB — shown once the bottom bar has content, replaces the bar's own affordance on very small screens ───── %>
    <button type="button" data-action="takeaway-checkout#openCart" data-takeaway-checkout-target="cartFab"
            class="md:hidden fixed bottom-[92px] right-4 z-30 w-14 h-14 rounded-tile bg-go text-surface
                   flex items-center justify-center shadow-lg active:scale-90 transition-transform" hidden>
     <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M4.00488 16V4H2.00488V2H5.00488C5.55717 2 6.00488 2.44772 6.00488 3V15H18.4433L20.4433 7H8.00488V5H21.7241C22.2764 5 22.7241 5.44772 22.7241 6C22.7241 6.08176 22.7141 6.16322 22.6942 6.24254L20.1942 16.2425C20.083 16.6877 19.683 17 19.2241 17H5.00488C4.4526 17 4.00488 16.5523 4.00488 16ZM6.00488 23C4.90031 23 4.00488 22.1046 4.00488 21C4.00488 19.8954 4.90031 19 6.00488 19C7.10945 19 8.00488 19.8954 8.00488 21C8.00488 22.1046 7.10945 23 6.00488 23ZM18.0049 23C16.9003 23 16.0049 22.1046 16.0049 21C16.0049 19.8954 16.9003 19 18.0049 19C19.1095 19 20.0049 19.8954 20.0049 21C20.0049 22.1046 19.1095 23 18.0049 23Z"></path></svg>
      <span data-takeaway-checkout-target="fabBadge"
            class="absolute -top-1.5 -right-1.5 min-w-[20px] h-5 px-1 rounded-full bg-stop text-surface
                   text-[11px] font-bold flex items-center justify-center leading-none" hidden></span>
    </button>

    <%# ── mobile cart sheet — slides up, own header/list/footer, mirrors the sidebar content ───── %>
    <div data-takeaway-checkout-target="sheetBackdrop" data-action="click->takeaway-checkout#closeCart"
         class="md:hidden fixed inset-0 z-40 bg-black/40 opacity-0 pointer-events-none transition-opacity duration-300" hidden></div>
    <div data-takeaway-checkout-target="sheet"
         class="md:hidden fixed left-0 right-0 bottom-0 z-50 max-h-[85dvh] flex flex-col
                bg-surface rounded-t-[24px] shadow-2xl translate-y-full transition-transform duration-300 ease-out"
         hidden>
      <div class="shrink-0 pt-3 pb-2 flex justify-center">
        <span class="w-10 h-1.5 rounded-full bg-line-2"></span>
      </div>
      <div class="shrink-0 px-4 pb-2 flex items-center justify-between">
        <h2 class="text-[19px] font-bold"><%= t("table_sessions.show.cart") %></h2>
        <div class="flex items-center gap-3">
          <button type="button" data-action="takeaway-checkout#clearCart"
                  class="text-[14px] font-semibold text-ink-3 active:text-stop">
            <%= t(".clear") %>
          </button>
          <button type="button" data-action="takeaway-checkout#closeCart" class="min-h-[44px] px-3 text-[15px] font-bold text-ink-3">✕</button>
        </div>
      </div>
      <div class="flex-1 overflow-y-auto px-4 py-2 flex flex-col gap-2" data-takeaway-checkout-target="cartListMobile"></div>
      <div class="shrink-0 border-t border-line p-4 pb-[max(1rem,env(safe-area-inset-bottom))]" data-takeaway-checkout-target="cartFooterMobile"></div>
    </div>

    <%# ── payment modal — bottom sheet on mobile, centered card on desktop ───── %>
    <div data-takeaway-checkout-target="payBackdrop" data-action="click->takeaway-checkout#closePayment"
         class="fixed inset-0 z-40 bg-black/40 opacity-0 pointer-events-none transition-opacity duration-300" hidden></div>
    <div data-takeaway-checkout-target="payPanel"
         class="fixed inset-x-0 bottom-0 z-50 max-h-[85dvh] flex flex-col
                bg-surface rounded-t-[24px] shadow-2xl translate-y-full transition-transform duration-300 ease-out
                md:inset-0 md:m-auto md:bottom-auto md:w-[420px] md:h-fit md:max-h-[85dvh] md:rounded-[24px]"
         hidden>
      <div class="shrink-0 pt-3 pb-2 flex justify-center md:hidden">
        <span class="w-10 h-1.5 rounded-full bg-line-2"></span>
      </div>
      <div class="shrink-0 px-5 pt-4 pb-2 flex items-center justify-between">
        <h2 class="text-[19px] font-bold"><%= t(".payment") %></h2>
        <button type="button" data-action="takeaway-checkout#closePayment" class="min-h-[44px] px-3 text-[15px] font-bold text-ink-3">✕</button>
      </div>
      <div class="px-5 pb-5 overflow-y-auto" data-takeaway-checkout-target="payContent"></div>
    </div>

    <%# ── held-orders modal ───── %>
    <div data-takeaway-checkout-target="heldBackdrop" data-action="click->takeaway-checkout#closeHeld"
         class="fixed inset-0 z-40 bg-black/40 opacity-0 pointer-events-none transition-opacity duration-300" hidden></div>
    <div data-takeaway-checkout-target="heldPanel"
         class="fixed inset-x-0 bottom-0 z-50 max-h-[80dvh] flex flex-col
                bg-surface rounded-t-[24px] shadow-2xl translate-y-full transition-transform duration-300 ease-out
                md:inset-0 md:m-auto md:bottom-auto md:w-[480px] md:h-fit md:max-h-[85dvh] md:rounded-[24px]"
         hidden>
      <div class="shrink-0 pt-3 pb-2 flex justify-center md:hidden">
        <span class="w-10 h-1.5 rounded-full bg-line-2"></span>
      </div>
      <div class="shrink-0 px-5 pt-4 pb-2 flex items-center justify-between">
        <h2 class="text-[19px] font-bold"><%= t(".held_orders") %></h2>
        <button type="button" data-action="takeaway-checkout#closeHeld" class="min-h-[44px] px-3 text-[15px] font-bold text-ink-3">✕</button>
      </div>
      <div data-takeaway-checkout-target="heldList" class="flex-1 overflow-y-auto px-5 pb-5 flex flex-col gap-2.5"></div>
    </div>
  </div>
<% else %>
  <div class="min-h-screen bg-shell flex flex-col">
    <header class="bg-ink text-surface px-5 py-4 flex items-center justify-between gap-3 flex-wrap">
      <div class="text-[22px] font-bold"><%= @dining_table.label %></div>
      <%= link_to "← #{t('.all_tables')}", dining_tables_path, class: "text-[16px] underline opacity-85" %>
    </header>

    <div class="p-4 flex flex-col items-center gap-4 w-full">
      <% if @invoice %>
        <% latest_print_job = @invoice.print_jobs.order(:created_at).last %>
        <% if latest_print_job&.status == "failed" %>
          <div class="w-full max-w-[340px] px-3 py-2 rounded-ctl bg-stop-50 border-2 border-stop text-stop text-[14px] font-semibold text-center">
            <%= t(".print_failed", error: latest_print_job.last_error) %>
          </div>
        <% end %>
      <% end %>

      <%# receipt preview — mirrors EscposReceipt's field order exactly (design_system §2.5),
          so what the cashier sees on screen matches what the thermal printer produces.
          .receipt-print-root is the only thing visible to window.print(). %>
      <div class="receipt-print-root">
        <div class="receipt-preview rounded-ctl border border-line-2 shadow-sm p-4">
          <div class="text-center">
            <p class="font-bold text-[16px]"><%= Current.shop.name %></p>
            <% if Current.shop.address.present? %>
              <p class="text-[12px]"><%= Current.shop.address %></p>
            <% end %>
            <% if @invoice&.gstin_snapshot.present? %>
              <p class="text-[12px]">GSTIN: <%= @invoice.gstin_snapshot %></p>
            <% end %>
            <% if Current.shop.fssai_licence.present? %>
              <p class="text-[12px]">FSSAI: <%= Current.shop.fssai_licence %></p>
            <% end %>
          </div>

          <div class="receipt-rule my-2"></div>

          <% if @invoice %>
            <p class="text-[13px]"><%= t(".invoice_number", number: @invoice.number) %></p>
            <p class="text-[13px]"><%= @invoice.issued_at.strftime("%d-%b-%Y %H:%M") %></p>
          <% end %>
          <p class="text-[13px]"><%= @dining_table.label %></p>

          <div class="receipt-rule my-2"></div>

          <% @tickets.each do |ticket| %>
            <% ticket.ticket_items.active.each do |item| %>
              <div class="flex justify-between gap-3 text-[13px] py-0.5">
                <span class="flex-1"><%= item.quantity %> x <%= item.name_snapshot %></span>
                <span><%= money_to_inr(item.quantity * item.unit_price_paise) %></span>
              </div>
            <% end %>
          <% end %>

          <div class="receipt-rule my-2"></div>

          <div class="flex justify-between text-[13px]"><span><%= t(".subtotal") %></span><span><%= money_to_inr(@billing.taxable_paise) %></span></div>
          <% if Current.shop.composition_scheme %>
            <p class="text-[12px] mt-1"><%= t(".composition_declaration") %></p>
          <% else %>
            <div class="flex justify-between text-[13px]"><span><%= t(".cgst") %></span><span><%= money_to_inr(@billing.cgst_paise) %></span></div>
            <div class="flex justify-between text-[13px]"><span><%= t(".sgst") %></span><span><%= money_to_inr(@billing.sgst_paise) %></span></div>
          <% end %>
          <% if @billing.round_off_paise.to_i != 0 %>
            <div class="flex justify-between text-[13px]"><span><%= t(".round_off") %></span><span><%= money_to_inr(@billing.round_off_paise) %></span></div>
          <% end %>

          <div class="receipt-rule my-2"></div>

          <div class="flex justify-between text-[16px] font-bold"><span><%= t(".total_with_tax") %></span><span><%= money_to_inr(@billing.total_paise) %></span></div>

          <div class="receipt-rule my-2"></div>

          <p class="text-center text-[13px]"><%= t(".session_status", status: @table_session.status) %></p>
          <% if Current.shop.invoice_footer.present? %>
            <p class="text-center text-[12px] mt-1"><%= Current.shop.invoice_footer %></p>
          <% end %>
        </div>
      </div>

      <div class="w-full max-w-[340px] flex flex-col gap-2.5">
        <% if @invoice %>
          <button type="button" onclick="window.print()"
                  class="w-full min-h-[64px] rounded-tile text-[18px] font-bold bg-go text-surface active:bg-go-700">
            <%= t(".print_receipt") %>
          </button>
          <%= button_to t(".reprint_to_printer"), reprint_invoice_path(@invoice), method: :post,
                class: "w-full min-h-[56px] rounded-tile text-[15px] font-bold border-2 border-line-2 bg-card active:bg-key" %>
        <% end %>
        <%= link_to t(".new_order"), takeaway_path,
              class: "text-center min-h-[56px] flex items-center justify-center rounded-tile text-[15px] font-bold bg-key text-ink active:bg-key-2" %>
      </div>
    </div>
  </div>
<% end %>
