<section class="bg-card rounded-tile border border-line p-4">
  <h2 class="text-[19px] font-semibold text-ink-2 mb-2"><%= t("bills.show.items") %></h2>
  <ul class="flex flex-col gap-2">
    <% table_session.tickets.each do |ticket| %>
      <% ticket.ticket_items.active.each do |item| %>
        <li class="flex items-center justify-between gap-3 py-2.5 border-b border-line last:border-0 flex-wrap">
          <span class="text-[22px] flex-1 min-w-[180px]">
            <span class="font-mono text-ink-2"><%= item.quantity %> ×</span> <%= item.name_snapshot %>
          </span>
          <span class="w-[130px] text-right font-mono text-[20px]"><%= money(item.quantity * item.unit_price_paisa) %></span>
          <% if table_session.status == "open" %>
            <details class="w-full sm:w-auto" data-controller="bill-panel">
              <summary class="shrink-0 min-h-[48px] px-4 rounded-key text-[17px] font-bold border-[2px] border-stop text-stop active:bg-stop-50 flex items-center justify-center cursor-pointer select-none">
                <%= t("bills.show.void") %>
              </summary>
              <%# void modal — reason mandatory, chips first (design_system §2.4) %>
              <div class="mt-2 p-3.5 rounded-tile border-t-8 border-stop bg-card shadow-lg">
                <%= form_with url: void_ticket_item_path(item), method: :patch do %>
                  <%= hidden_field_tag :reason, nil, data: { bill_panel_target: "voidReasonField" } %>
                  <div class="flex flex-wrap gap-2 mb-2.5">
                    <% [
                      t("bills.show.void_reason_wrong_order"),
                      t("bills.show.void_reason_customer_returned"),
                      t("bills.show.void_reason_spoiled")
                    ].each do |reason| %>
                      <button type="button" data-action="bill-panel#chooseVoidReason" data-bill-panel-reason-param="<%= reason %>"
                              data-bill-panel-target="voidReasonChip"
                              class="min-h-[44px] px-3.5 rounded-key text-[15px] font-semibold border-2 border-line-2">
                        <%= reason %>
                      </button>
                    <% end %>
                  </div>
                  <%= text_field_tag :void_reason_other, nil, placeholder: t("bills.show.void_reason_other_placeholder"),
                        data: { action: "input->bill-panel#typeVoidReason", bill_panel_target: "voidReasonOther" },
                        class: "w-full min-h-[48px] px-3 rounded-key border-2 border-line-2 text-[16px] mb-2.5" %>
                  <%= submit_tag t("bills.show.void"), disabled: true, data: { bill_panel_target: "voidSubmit" },
                        class: "w-full min-h-[52px] rounded-ctl text-[17px] font-bold bg-stop text-surface disabled:bg-key-2 disabled:text-ink-4" %>
                <% end %>
              </div>
            </details>
          <% end %>
        </li>
      <% end %>
    <% end %>
  </ul>
</section>

<section class="bg-card rounded-tile border border-line p-5">
  <div class="text-[24px] font-semibold"><%= t("bills.show.total_with_tax") %></div>
  <div class="text-[38px] font-mono font-bold"><%= money(billing.gross_paisa) %></div>

  <div class="mt-3 flex flex-col gap-1.5 text-[19px] text-ink-3">
    <div class="flex justify-between"><span><%= t("bills.show.subtotal") %></span><span class="font-mono"><%= money(billing.base_paisa) %></span></div>
    <div class="flex justify-between"><span><%= t("bills.show.service_charge") %></span><span class="font-mono"><%= money(billing.service_charge_paisa) %></span></div>
    <div class="flex justify-between"><span><%= t("bills.show.vat") %></span><span class="font-mono"><%= money(billing.vat_paisa) %></span></div>
    <% if table_session.discount_paisa.to_i > 0 %>
      <div class="flex justify-between text-go"><span><%= t("bills.show.discount_with_reason", reason: table_session.discount_reason) %></span><span class="font-mono">-<%= money(table_session.discount_paisa) %></span></div>
    <% end %>
  </div>
</section>

<% if table_session.status == "open" %>
  <section class="bg-card rounded-tile border border-line p-4" data-controller="bill-panel">
    <h2 class="text-[19px] font-semibold text-ink-2 mb-2"><%= t("bills.show.discount") %></h2>
    <%= form_with url: table_session_discount_path(table_session), method: :post, class: "flex flex-col gap-2.5" do %>
      <%= hidden_field_tag :amount_paisa, nil, data: { bill_panel_target: "discountAmountField" } %>
      <%= hidden_field_tag :reason, nil, data: { bill_panel_target: "discountReasonField" } %>
      <div class="flex flex-wrap gap-2">
        <% [5, 10, 15].each do |percent| %>
          <% amount_paisa = (billing.gross_paisa * percent / 100.0).round %>
          <button type="button" data-action="bill-panel#chooseDiscount"
                  data-bill-panel-amount-param="<%= amount_paisa %>"
                  data-bill-panel-reason-param="<%= percent %>%"
                  data-bill-panel-target="discountChip"
                  class="min-h-[52px] px-4 rounded-key text-[16px] font-bold border-2 border-line-2">
            <%= percent %>% <span class="font-mono text-[13px] font-normal text-ink-3">(<%= money(amount_paisa) %>)</span>
          </button>
        <% end %>
      </div>
      <%= text_field_tag :discount_custom, nil, placeholder: t("bills.show.discount_custom_placeholder"),
            data: { action: "input->bill-panel#typeCustomDiscount", bill_panel_target: "discountCustom" },
            class: "min-h-[52px] px-3 rounded-ctl border-2 border-line-2 font-mono text-[18px]" %>
      <%= submit_tag t("bills.show.apply_discount"), class: "min-h-[56px] rounded-ctl text-[19px] font-bold bg-key text-ink active:bg-key-2" %>
    <% end %>
  </section>

  <section class="rounded-tile border-2 border-go bg-go-50 p-4" data-controller="bill-panel"
           data-bill-panel-remaining-paisa-value="<%= billing.gross_paisa - table_session.paid_paisa %>">
    <div class="text-[24px] font-bold">
      <% remaining = billing.gross_paisa - table_session.paid_paisa %>
      <% if remaining <= 0 %>
        <%= t("bills.show.fully_paid") %>
      <% else %>
        <%= t("bills.show.remaining", amount: money(remaining)) %>
      <% end %>
    </div>
    <div class="text-[18px] text-ink-3"><%= t("bills.show.paid_so_far", amount: money(table_session.paid_paisa)) %></div>

    <% if remaining > 0 %>
      <%# payment method chips (design_system §2.4 — four buttons, min-h 84px, border-ink) %>
      <div class="mt-3 grid grid-cols-2 gap-2.5">
        <% Payment::METHODS.each do |method| %>
          <button type="button" data-action="bill-panel#chooseMethod" data-bill-panel-method-param="<%= method %>"
                  data-bill-panel-target="methodChip"
                  class="min-h-[64px] px-3 rounded-tile text-[18px] font-bold border-[2.5px] border-line-2 active:bg-key">
            <%= t("bills.show.pay_method_#{method}") %>
          </button>
        <% end %>
      </div>

      <%= form_with url: table_session_payments_path(table_session), method: :post, class: "mt-3 flex flex-col gap-2.5" do %>
        <%= hidden_field_tag "payment[method]", "cash", data: { bill_panel_target: "methodField" } %>
        <%= hidden_field_tag "payment[amount_paisa]", remaining, data: { bill_panel_target: "payAmount" } %>

        <div data-bill-panel-target="payMoreFields">
          <div class="text-[13px] text-ink-3 font-semibold uppercase tracking-wide mb-1.5"><%= t("bills.show.cash_received") %></div>
          <div class="grid grid-cols-4 gap-2 mb-2.5">
            <% amounts = [remaining, remaining.fdiv(100).ceil * 100].uniq.sort %>
            <% [2000, 5000, 10000].each { |bill| amounts << bill * 100 if bill * 100 >= remaining } %>
            <% amounts = amounts.uniq.sort.first(4) %>
            <% amounts.each do |amount| %>
              <button type="button" data-action="bill-panel#setCashAmount" data-bill-panel-amount-param="<%= amount %>"
                      data-bill-panel-target="cashChip"
                      class="min-h-[52px] rounded-key border-2 border-line-2 font-mono font-bold text-[16px]">
                <%= money(amount) %>
              </button>
            <% end %>
          </div>
          <%= text_field_tag :payment_other_amount, nil, placeholder: t("bills.show.other_amount"), inputmode: "numeric",
                data: { action: "input->bill-panel#typeCashAmount" },
                class: "w-full min-h-[52px] px-3 rounded-ctl border-2 border-line-2 font-mono text-[18px] mb-2.5" %>
          <div data-bill-panel-target="changeDisplay" class="mb-1"></div>
        </div>

        <%= text_field_tag "payment[reference]", nil, placeholder: t("bills.show.reference_placeholder"),
              class: "min-h-[52px] px-3 rounded-ctl border-2 border-line-2 text-[17px]" %>

        <%= submit_tag t("bills.show.record_payment"), disabled: true, data: { bill_panel_target: "paySubmit" },
              class: "min-h-[84px] rounded-tile text-[20px] font-bold border-[2.5px] border-ink bg-card active:bg-key disabled:opacity-40" %>
      <% end %>
    <% end %>
  </section>
<% else %>
  <div class="text-center text-[19px] text-ink-3"><%= t("bills.show.session_status", status: table_session.status) %></div>

  <% if invoice %>
    <section class="bg-card rounded-tile border border-line p-4">
      <h2 class="text-[20px] font-bold mb-1"><%= t("bills.show.invoice_number", number: invoice.number) %></h2>
      <% latest_print_job = invoice.print_jobs.order(:created_at).last %>
      <% if latest_print_job %>
        <p class="text-[18px] text-ink-3"><%= t("bills.show.print_status", status: latest_print_job.status) %></p>
        <% if latest_print_job.status == "failed" %>
          <p class="mt-1 px-3 py-2 rounded-ctl bg-stop-50 border-2 border-stop text-stop text-[18px] font-semibold">
            <%= t("bills.show.print_failed", error: latest_print_job.last_error) %>
          </p>
        <% end %>
      <% end %>
      <% if invoice.print_count.to_i > 0 %>
        <p class="text-[16px] text-ink-3 mt-1"><%= t("bills.show.reprinted_count", count: invoice.print_count) %></p>
      <% end %>
      <%= button_to t("bills.show.print_bill"), reprint_invoice_path(invoice), method: :post,
            class: "mt-3 w-full min-h-[70px] rounded-tile text-[20px] font-bold bg-go text-surface active:bg-go-700" %>
    </section>
  <% end %>
<% end %>
