<div class="min-h-screen bg-shell">
  <header class="bg-ink text-surface px-5 py-4 flex items-center justify-between gap-4 flex-wrap">
    <div class="text-[22px] font-bold"><%= t(".title") %></div>
    <nav class="flex items-center gap-2 flex-wrap text-[16px] font-semibold">
      <%= link_to "EN", locale_path(locale: "en"), data: { turbo_method: :patch },
            class: "px-2.5 py-1.5 rounded-key text-[13px] font-bold bg-wall-3 text-surface active:bg-key-2 active:text-ink" %>
      <%= link_to "ने", locale_path(locale: "ne"), data: { turbo_method: :patch },
            class: "px-2.5 py-1.5 rounded-key text-[13px] font-bold bg-wall-3 text-surface active:bg-key-2 active:text-ink" %>
      <%= link_to t(".kitchen"), kitchen_tickets_path, class: "px-3.5 py-2 rounded-key bg-wall-3 active:bg-key-2" %>
      <% if @dining_tables.any?(&:takeaway?) %>
        <%= link_to t(".takeaway"), takeaway_path, class: "px-3.5 py-2 rounded-key bg-wall-3 active:bg-key-2" %>
      <% end %>
      <%= link_to t("shared.sign_out"), session_path, data: { turbo_method: :delete },
            class: "px-3.5 py-2 rounded-key bg-stop text-surface active:bg-stop-50 active:text-stop" %>
    </nav>
  </header>

  <% if @dining_tables.empty? %>
    <div class="p-6 text-center flex flex-col gap-3 items-center">
      <div class="text-[18px] text-ink-3"><%= t(".no_tables") %></div>
    </div>
  <% end %>

  <div class="p-4 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3.5">
    <% @dining_tables.reject(&:takeaway?).each do |dining_table| %>
      <% session = dining_table.open_session %>
      <div class="min-h-[140px] p-4 rounded-tile border-2 <%= session ? 'bg-go-50 border-go' : 'bg-card border-line' %> flex flex-col justify-between gap-3">
        <div>
          <div class="text-[22px] font-bold"><%= dining_table.label %></div>
          <div class="text-[16px] text-ink-3"><%= t(".seats", count: dining_table.seats) %></div>
        </div>
        <% if session %>
          <%= link_to t(".continue_order"), table_session_path(session),
                class: "min-h-[56px] px-3 rounded-ctl text-[17px] font-bold bg-go text-surface active:bg-go-700 flex items-center justify-center text-center" %>
        <% else %>
          <%= button_to t(".open_table"), table_sessions_path(dining_table_id: dining_table.id),
                class: "w-full min-h-[56px] px-3 rounded-ctl text-[17px] font-bold bg-key text-ink active:bg-key-2" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
