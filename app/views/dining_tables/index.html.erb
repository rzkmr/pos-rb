<h1>Tables</h1>

<p>
  <%= link_to "Kitchen", kitchen_tickets_path %>
  <% if Current.user&.role == "admin" %>
    · <%= link_to "Menu", admin_menu_items_path %>
    · <%= link_to "Users", admin_users_path %>
    · <%= link_to "Sales", admin_sales_path %>
    · <%= link_to "Devices", devices_path %>
  <% end %>
  · <%= link_to "Sign out", session_path, data: { turbo_method: :delete } %>
</p>

<ul>
  <% @dining_tables.each do |dining_table| %>
    <% session = dining_table.open_session %>
    <li>
      <strong><%= dining_table.label %></strong>
      (<%= dining_table.seats %> seats)
      <% if session %>
        — open
        <%= link_to "Continue order", table_session_path(session) %>
      <% else %>
        <%= button_to "Open table", table_sessions_path(dining_table_id: dining_table.id) %>
      <% end %>
    </li>
  <% end %>
</ul>
