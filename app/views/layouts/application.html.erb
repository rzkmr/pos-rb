<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Pos Rb" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Pos Rb">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <meta name="theme-color" content="#1d5c48">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :tailwind, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <%# Offline priming/connectivity is for the shop-floor PWA (Current.user,
      a staff PIN session on a paired device) — admin is the office/backend
      surface (menu, tables, settings) and is explicitly device-independent
      (see Admin::BaseController), so it must never trigger device-gated
      priming against /catalog_snapshot. %>
  <% show_connectivity = Current.user %>
  <% body_controllers = [] %>
  <% body_controllers << "connectivity" if show_connectivity %>
  <% body_controllers << "pwa-install" if show_connectivity %>
  <body class="bg-shell text-ink" data-controller="<%= body_controllers.join(' ') %>">
    <% if show_connectivity %>
      <div data-controller="priming-overlay" hidden
           class="fixed inset-0 z-[100] bg-shell flex flex-col items-center justify-center gap-3 p-6 text-center">
        <div class="w-8 h-8 border-[3px] border-line-2 border-t-go rounded-full animate-spin" data-priming-overlay-target="spinner"></div>
        <p class="text-[16px] text-ink-3" data-priming-overlay-target="status"></p>
        <button type="button" data-action="priming-overlay#retry" hidden
                data-priming-overlay-target="retryButton"
                class="mt-2 min-h-[48px] px-4 rounded-ctl border-2 border-line-2 text-[14px] font-bold">
          <%= t("shared.retry") %>
        </button>
      </div>
      <div data-controller="offline-banner" hidden
           class="flex items-center justify-center gap-2 px-4 py-2 bg-warn text-warn-900 text-[14px] font-bold text-center">
        <%= t("shared.offline_banner") %>
      </div>
    <% end %>
    <%# Not gated behind show_connectivity — the offline shell is reachable
        with no signed-in session at all (OfflineShellsController skips
        require_user), and it's exactly the screen most likely to
        accumulate unsent completed orders while nobody's signed in. The
        badge itself only reads IndexedDB, so it needs no auth to be
        useful. %>
    <div data-controller="pending-badge" hidden
         class="fixed bottom-4 right-4 z-50 flex items-center gap-1.5 px-3 py-2 rounded-full bg-warn text-warn-900 text-[13px] font-bold shadow-lg">
      <span data-pending-badge-target="count"></span>
      <span><%= t("shared.pending_sync") %></span>
    </div>
    <%= render "shared/flash" unless content_for?(:flash_in_card) %>
    <%= yield %>
  </body>
</html>
