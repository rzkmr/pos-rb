<div class="h-[100dvh] bg-shell flex flex-col overflow-hidden" data-controller="order-cart"
     data-order-cart-table-session-id-value="<%= @table_session.id %>"
     data-order-cart-submit-url-value="<%= tickets_path %>">

  <header class="shrink-0 bg-go text-[#f2f7f4] px-4 pt-[max(0.875rem,env(safe-area-inset-top))] pb-3.5">
    <div class="flex items-center justify-between gap-3">
      <div class="min-w-0">
        <div class="text-[22px] sm:text-[24px] font-bold truncate"><%= @dining_table.label %></div>
        <div class="text-[15px] sm:text-[16px] opacity-85"><%= t(".seats", count: @dining_table.seats) %></div>
      </div>
      <div class="flex items-center gap-1.5 shrink-0">
        <%= link_to "EN", locale_path(locale: "en"), data: { turbo_method: :patch },
              class: "px-2.5 py-1.5 rounded-key text-[13px] font-bold bg-wall-3 text-surface active:bg-key-2 active:text-ink" %>
        <%= link_to "ने", locale_path(locale: "ne"), data: { turbo_method: :patch },
              class: "px-2.5 py-1.5 rounded-key text-[13px] font-bold bg-wall-3 text-surface active:bg-key-2 active:text-ink" %>
      </div>
    </div>
    <div class="mt-1 flex items-center justify-between gap-2 flex-wrap">
      <div class="text-[14px] sm:text-[15px] opacity-85">
        <%= link_to "← #{t('.all_tables')}", dining_tables_path, class: "underline" %>
      </div>
      <button type="button" data-action="order-cart#openBill" data-order-cart-bill-url-param="<%= table_session_bill_path(@table_session) %>"
              class="min-h-[36px] px-3 rounded-key text-[14px] font-bold bg-wall-3 text-surface active:bg-key-2 active:text-ink">
        <%= t(".bill") %> ›
      </button>
    </div>
  </header>

  <div id="pending-banner" data-order-cart-target="pendingBanner"
       class="shrink-0 flex items-center gap-2.5 px-4 py-3 bg-warn text-warn-900 border-b-[3px] border-warn-700" hidden>
    <span class="w-3.5 h-3.5 rounded-full bg-[#7a5300] animate-pulse shrink-0"></span>
    <span class="text-[15px] sm:text-[17px] font-bold">
      <span data-order-cart-target="pendingCount"></span> <%= t(".sending_orders") %>
    </span>
  </div>

  <% if @tickets.any? %>
    <details class="shrink-0 border-b border-line bg-surface">
      <summary class="px-4 py-2.5 text-[15px] font-semibold text-ink-2 cursor-pointer select-none">
        <%= t(".previous_rounds") %> (<%= @tickets.size %>)
      </summary>
      <div class="px-4 pb-3 flex flex-col gap-2 max-h-[30dvh] overflow-y-auto">
        <% @tickets.each do |ticket| %>
          <div class="p-3 rounded-ctl bg-card border border-line">
            <div class="text-[15px] font-bold text-ink-2"><%= t(".round_label", number: ticket.number) %> — <%= ticket.status %></div>
            <ul class="text-[15px] mt-1">
              <% ticket.ticket_items.each do |item| %>
                <li><span class="font-mono"><%= item.quantity %> ×</span> <%= item.name_snapshot %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>
    </details>
  <% end %>

  <%# category rail — sticky, horizontally scroll-snapped, thumb-reachable %>
  <nav class="shrink-0 border-b border-line bg-surface overflow-x-auto [-webkit-overflow-scrolling:touch]"
       style="scrollbar-width: none;" data-order-cart-target="categoryRail">
    <div class="flex gap-2 px-3.5 py-2.5 w-max snap-x">
      <% @menu_items.group_by(&:category).keys.each_with_index do |category, index| %>
        <button type="button" data-action="order-cart#jumpToCategory" data-order-cart-category-param="<%= category %>"
                data-order-cart-target="categoryTab"
                class="snap-start shrink-0 min-h-[44px] px-4 rounded-key text-[15px] font-bold whitespace-nowrap
                       <%= index.zero? ? 'bg-ink text-surface' : 'bg-key text-ink' %>">
          <%= t(".category_#{category}", default: category.titleize) %>
        </button>
      <% end %>
    </div>
  </nav>

  <%# item list — single column, full-width rows, left accent bar fills on qty > 0 %>
  <section class="flex-1 overflow-y-auto" data-order-cart-target="itemList">
    <% @menu_items.group_by(&:category).each do |category, items| %>
      <div data-order-cart-category-section="<%= category %>" class="scroll-mt-2">
        <div class="sticky top-0 z-10 px-4 py-2 bg-shell/95 backdrop-blur-sm text-[13px] font-bold tracking-wide text-ink-3 uppercase">
          <%= t(".category_#{category}", default: category.titleize) %>
        </div>
        <div class="flex flex-col">
          <% items.each do |menu_item| %>
            <button type="button"
                    data-action="order-cart#add"
                    data-order-cart-menu-item-id-param="<%= menu_item.id %>"
                    data-order-cart-menu-item-name-param="<%= menu_item.name %>"
                    data-order-cart-menu-item-price-param="<%= menu_item.price_paise %>"
                    data-order-cart-target="itemRow"
                    data-order-cart-item-id="<%= menu_item.id %>"
                    class="chit-row-fill group relative min-h-[64px] w-full px-4 py-3 flex items-center gap-3.5
                           border-b border-line/70 text-left active:bg-go-50">
              <span class="shrink-0 w-1 self-stretch -my-3 rounded-full bg-line-2 transition-[width,background-color] duration-200
                           group-active:bg-go" data-order-cart-target="rowAccent"></span>
              <span class="flex-1 min-w-0">
                <span class="block text-[18px] font-semibold leading-[1.3] truncate"><%= menu_item.name %></span>
                <span class="block text-[15px] font-mono text-ink-3"><%= money_to_inr(menu_item.price_paise) %></span>
              </span>
              <span class="shrink-0 min-w-[2.75rem] text-right text-[17px] font-bold font-mono text-go"
                    data-order-cart-target="rowQty"></span>
            </button>
          <% end %>
        </div>
      </div>
    <% end %>
  </section>

  <%# the chit — collapsed running-order strip with a torn-paper top edge.
      Tapping/dragging it up reveals the full order as a bottom sheet. %>
  <div class="shrink-0 relative">
    <button type="button" data-action="order-cart#toggleSheet" data-order-cart-target="chitBar"
            class="chit-torn-edge w-full pt-4 pb-[max(0.875rem,env(safe-area-inset-bottom))] px-4
                   bg-chit border-t border-chit-edge flex items-center justify-between gap-3"
            hidden>
      <span class="flex items-center gap-2.5 min-w-0">
        <span class="shrink-0 w-2.5 h-2.5 rounded-full bg-go"></span>
        <span class="text-[16px] font-bold truncate" data-order-cart-target="chitSummary"></span>
      </span>
      <span class="shrink-0 flex items-center gap-2">
        <span class="text-[20px] font-mono font-bold" data-order-cart-target="chitTotal"></span>
        <span class="text-ink-3 text-[13px] font-bold"><%= t(".view_order") %> ▴</span>
      </span>
    </button>

    <%# empty-cart footer state — shown when nothing added yet %>
    <div data-order-cart-target="emptyFooter" class="px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] bg-surface border-t border-line">
      <p class="text-[15px] text-ink-3 text-center"><%= t(".cart_empty") %></p>
    </div>
  </div>

  <%# bottom sheet — full order review + send. Hidden until the chit is tapped. %>
  <div data-order-cart-target="sheetBackdrop" data-action="click->order-cart#closeSheet"
       class="fixed inset-0 z-40 bg-black/40 transition-opacity duration-200" hidden></div>
  <div data-order-cart-target="sheet"
       class="fixed left-0 right-0 bottom-0 z-50 max-h-[80dvh] flex flex-col
              bg-surface rounded-t-[24px] shadow-2xl translate-y-full transition-transform duration-200 ease-out"
       hidden>
    <div class="shrink-0 pt-3 pb-2 flex justify-center">
      <span class="w-10 h-1.5 rounded-full bg-line-2"></span>
    </div>
    <div class="shrink-0 px-4 pb-2 flex items-center justify-between">
      <h2 class="text-[19px] font-bold"><%= t(".cart") %></h2>
      <button type="button" data-action="order-cart#toggleSheet" class="min-h-[44px] px-3 text-[15px] font-bold text-ink-3">✕</button>
    </div>
    <ul data-order-cart-target="list" class="flex-1 overflow-y-auto px-4 flex flex-col gap-1.5 pb-3"></ul>

    <%# undo toast — beats a confirm dialog for a reversible action (design_system §3) %>
    <div data-order-cart-target="undoToast"
         class="mx-4 mb-3 flex items-center gap-3 px-4 py-3.5 rounded-tile bg-ink text-surface" hidden>
      <span class="flex-1 text-[16px] font-semibold" data-order-cart-target="undoText"></span>
      <button type="button" data-action="order-cart#undoRemove"
              class="shrink-0 min-h-[44px] px-4 rounded-key bg-warn text-warn-900 text-[16px] font-bold">
        <%= t(".undo") %>
      </button>
    </div>
    <div class="shrink-0 px-4 pt-3 pb-[max(1rem,env(safe-area-inset-bottom))] border-t border-line bg-surface flex items-center justify-between gap-4">
      <div>
        <div class="text-[13px] text-ink-3 font-semibold uppercase tracking-wide"><%= t("shared.total") %></div>
        <div class="text-[24px] font-mono font-bold" data-order-cart-target="sheetTotal"></div>
      </div>
      <button type="button" data-action="order-cart#submit" data-order-cart-target="submit" disabled
              class="flex-1 min-h-[64px] px-4 rounded-tile text-[19px] font-bold
                     bg-go text-surface active:bg-go-700
                     disabled:bg-key-2 disabled:text-ink-4">
        <%= t(".send_to_kitchen") %>
      </button>
    </div>
  </div>

  <%# bill panel — same table_session, no page nav. Lazy-loads bill content via
      Turbo Frame the first time it's opened, so it's cheap on every order-screen load. %>
  <div data-order-cart-target="billBackdrop" data-action="click->order-cart#closeBill"
       class="fixed inset-0 z-40 bg-black/40 transition-opacity duration-200" hidden></div>
  <div data-order-cart-target="billPanel"
       class="fixed left-0 right-0 bottom-0 z-50 max-h-[90dvh] flex flex-col
              bg-surface rounded-t-[24px] shadow-2xl translate-y-full transition-transform duration-200 ease-out"
       hidden>
    <div class="shrink-0 pt-3 pb-2 flex justify-center">
      <span class="w-10 h-1.5 rounded-full bg-line-2"></span>
    </div>
    <div class="shrink-0 px-4 pb-2 flex items-center justify-between">
      <h2 class="text-[19px] font-bold"><%= t(".bill") %></h2>
      <button type="button" data-action="order-cart#closeBill" class="min-h-[44px] px-3 text-[15px] font-bold text-ink-3">✕</button>
    </div>

    <div data-order-cart-target="billUnsentWarning"
         class="shrink-0 mx-4 mb-2 px-3.5 py-3 rounded-ctl bg-warn-50 border-2 border-warn-700 text-warn-900 text-[16px] font-semibold" hidden>
      <%= t(".unsent_warning") %>
    </div>

    <div class="flex-1 overflow-y-auto px-4 pb-[max(1rem,env(safe-area-inset-bottom))] flex flex-col gap-4">
      <%= turbo_frame_tag "bill_panel_content" do %>
        <div class="py-10 text-center text-[16px] text-ink-3"><%= t(".loading") %></div>
      <% end %>
    </div>
  </div>
</div>
