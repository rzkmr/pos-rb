<div class="min-h-screen flex items-center justify-center bg-shell p-5">
  <div class="w-full max-w-[392px] bg-surface rounded-phone p-6 flex flex-col gap-6">
    <div class="flex items-center justify-end gap-2">
      <%= link_to "EN", locale_path(locale: "en"), data: { turbo_method: :patch },
            class: "px-2.5 py-1.5 rounded-key text-[13px] font-bold bg-wall-3 text-surface active:bg-key-2 active:text-ink" %>
      <%= link_to "ने", locale_path(locale: "ne"), data: { turbo_method: :patch },
            class: "px-2.5 py-1.5 rounded-key text-[13px] font-bold bg-wall-3 text-surface active:bg-key-2 active:text-ink" %>
    </div>
    <div>
      <div class="text-[21px] font-bold"><%= t(".title") %></div>
      <div class="text-[17px] text-ink-3"><%= t(".subtitle") %></div>
    </div>

    <% if flash[:alert] %>
      <div class="px-4 py-3 rounded-ctl bg-stop-50 border-2 border-stop text-stop text-[17px] font-semibold">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with url: admin_session_path, method: :post, class: "flex flex-col gap-5" do |f| %>
      <div class="flex flex-col gap-2">
        <%= f.label :username, class: "text-[17px] font-semibold" %>
        <%= f.text_field :username, autocomplete: "username", autofocus: true,
              class: "min-h-[56px] px-4 rounded-ctl border-2 border-line-2 bg-card text-[19px]" %>
      </div>

      <div class="flex flex-col gap-2">
        <%= f.label :password, class: "text-[17px] font-semibold" %>
        <%= f.password_field :password, autocomplete: "current-password",
              class: "min-h-[56px] px-4 rounded-ctl border-2 border-line-2 bg-card text-[19px]" %>
      </div>

      <%= f.submit t(".sign_in"),
            class: "min-h-[64px] px-4 py-2.5 rounded-tile text-[19px] font-bold bg-go text-surface active:bg-go-700" %>
    <% end %>
  </div>
</div>
