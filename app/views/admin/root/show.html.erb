<div class="min-h-screen bg-shell">
  <header class="bg-ink text-surface px-5 py-4 flex items-center justify-between gap-4 flex-wrap">
    <div class="text-[22px] font-bold"><%= t(".title") %></div>
    <nav class="flex items-center gap-2 flex-wrap text-[16px] font-semibold">
      <%= link_to "EN", locale_path(locale: "en"), data: { turbo_method: :patch },
            class: "px-2.5 py-1.5 rounded-key text-[13px] font-bold bg-wall-3 text-surface active:bg-key-2 active:text-ink" %>
      <%= link_to "ने", locale_path(locale: "ne"), data: { turbo_method: :patch },
            class: "px-2.5 py-1.5 rounded-key text-[13px] font-bold bg-wall-3 text-surface active:bg-key-2 active:text-ink" %>
      <%= link_to t("shared.sign_out"), admin_session_path, data: { turbo_method: :delete },
            class: "px-3.5 py-2 rounded-key bg-stop text-surface active:bg-stop-50 active:text-stop" %>
    </nav>
  </header>

  <div class="p-6 max-w-4xl mx-auto grid grid-cols-2 md:grid-cols-3 gap-4">
    <%= link_to admin_menu_items_path, class: "min-h-[100px] p-4 rounded-tile bg-card border-2 border-line flex flex-col justify-center gap-1 active:border-go active:bg-go-50" do %>
      <span class="text-[19px] font-bold"><%= t(".menu") %></span>
      <span class="text-[14px] text-ink-3"><%= t(".menu_desc") %></span>
    <% end %>

    <%= link_to admin_dining_tables_path, class: "min-h-[100px] p-4 rounded-tile bg-card border-2 border-line flex flex-col justify-center gap-1 active:border-go active:bg-go-50" do %>
      <span class="text-[19px] font-bold"><%= t(".tables") %></span>
      <span class="text-[14px] text-ink-3"><%= t(".tables_desc") %></span>
    <% end %>

    <%= link_to admin_users_path, class: "min-h-[100px] p-4 rounded-tile bg-card border-2 border-line flex flex-col justify-center gap-1 active:border-go active:bg-go-50" do %>
      <span class="text-[19px] font-bold"><%= t(".staff") %></span>
      <span class="text-[14px] text-ink-3"><%= t(".staff_desc") %></span>
    <% end %>

    <%= link_to admin_sales_path, class: "min-h-[100px] p-4 rounded-tile bg-card border-2 border-line flex flex-col justify-center gap-1 active:border-go active:bg-go-50" do %>
      <span class="text-[19px] font-bold"><%= t(".sales") %></span>
      <span class="text-[14px] text-ink-3"><%= t(".sales_desc") %></span>
    <% end %>

    <% no_devices = @paired_device_count.zero? %>
    <%= link_to devices_path, class: "min-h-[100px] p-4 rounded-tile border-2 flex flex-col justify-center gap-1 #{no_devices ? 'bg-warn-50 border-warn-700 active:bg-warn' : 'bg-card border-line active:border-go active:bg-go-50'}" do %>
      <span class="flex items-center justify-between gap-2">
        <span class="text-[19px] font-bold"><%= t(".devices") %></span>
        <% if no_devices %>
          <span class="px-2 py-0.5 rounded-key bg-warn-700 text-surface text-[12px] font-bold"><%= t(".devices_none_paired") %></span>
        <% else %>
          <span class="px-2 py-0.5 rounded-key bg-go-50 text-go text-[12px] font-bold"><%= t(".devices_paired_count", count: @paired_device_count) %></span>
        <% end %>
      </span>
      <span class="text-[14px] text-ink-3"><%= t(".devices_desc") %></span>
    <% end %>

    <%= link_to edit_admin_settings_path, class: "min-h-[100px] p-4 rounded-tile bg-card border-2 border-line flex flex-col justify-center gap-1 active:border-go active:bg-go-50" do %>
      <span class="text-[19px] font-bold"><%= t(".settings") %></span>
      <span class="text-[14px] text-ink-3"><%= t(".settings_desc") %></span>
    <% end %>
  </div>
</div>
