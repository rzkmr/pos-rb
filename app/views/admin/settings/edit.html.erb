<div class="min-h-screen bg-shell p-6">
  <div class="max-w-lg mx-auto flex flex-col gap-4">
    <%= render "admin/shared/breadcrumb", title: t(".title") %>
    <h1 class="text-[26px] font-bold"><%= t(".title") %></h1>

    <%= form_with model: @shop, url: admin_settings_path, method: :patch, class: "flex flex-col gap-4" do |f| %>
      <% if @shop.errors.any? %>
        <div class="px-4 py-3 rounded-ctl bg-stop-50 border-2 border-stop text-stop text-[15px]">
          <ul class="list-disc pl-5">
            <% @shop.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="text-[15px] font-bold text-ink-2 pt-2"><%= t(".shop_details") %></div>

      <div class="flex flex-col gap-1.5">
        <%= f.label :name, class: "text-[15px] font-semibold" %>
        <%= f.text_field :name, class: "min-h-[48px] px-3 rounded-ctl border-2 border-line-2 text-[16px]" %>
      </div>

      <div class="flex flex-col gap-1.5">
        <%= f.label :address, class: "text-[15px] font-semibold" %>
        <%= f.text_field :address, class: "min-h-[48px] px-3 rounded-ctl border-2 border-line-2 text-[16px]" %>
      </div>

      <div class="flex flex-col gap-1.5">
        <%= f.label :gstin, class: "text-[15px] font-semibold" %>
        <%= f.text_field :gstin, class: "min-h-[48px] px-3 rounded-ctl border-2 border-line-2 font-mono text-[16px]" %>
      </div>

      <div class="flex flex-col gap-1.5">
        <%= f.label :state_code, t(".gst_state_code"), class: "text-[15px] font-semibold" %>
        <%= f.text_field :state_code, maxlength: 2, class: "min-h-[48px] px-3 rounded-ctl border-2 border-line-2 font-mono text-[16px]" %>
      </div>

      <div class="flex flex-col gap-1.5">
        <%= f.label :fssai_licence, t(".fssai_licence"), class: "text-[15px] font-semibold" %>
        <%= f.text_field :fssai_licence, class: "min-h-[48px] px-3 rounded-ctl border-2 border-line-2 font-mono text-[16px]" %>
      </div>

      <div class="flex items-center gap-2">
        <%= f.check_box :composition_scheme, class: "w-5 h-5" %>
        <%= f.label :composition_scheme, t("shared.composition_scheme"), class: "text-[15px] font-semibold" %>
      </div>

      <div class="flex flex-col gap-1.5">
        <%= f.label :invoice_footer, class: "text-[15px] font-semibold" %>
        <%= f.text_area :invoice_footer, rows: 2, class: "px-3 py-2 rounded-ctl border-2 border-line-2 text-[16px]" %>
      </div>

      <div class="text-[15px] font-bold text-ink-2 pt-2 border-t border-line"><%= t(".pairing_section") %></div>
      <div class="text-[14px] text-ink-3">
        <%= t(".pairing_pin_help") %>
      </div>

      <% if @shop.pairing_pin.present? %>
        <div class="rounded-ctl bg-go-50 border-2 border-go p-4">
          <p class="text-[13px] font-semibold text-go uppercase tracking-wide"><%= t(".current_pairing_pin") %></p>
          <p class="text-[32px] font-mono font-bold tracking-[0.3em] text-ink"><%= @shop.pairing_pin %></p>
          <p class="text-[13px] text-ink-3 mt-1"><%= t(".current_pairing_pin_help") %></p>
        </div>
      <% end %>

      <div class="flex flex-col gap-1.5" data-controller="pin-generator">
        <%= label_tag :admin_pin, t(".new_pairing_pin"), class: "text-[15px] font-semibold" %>
        <div class="flex gap-2">
          <%= password_field_tag :admin_pin, nil, maxlength: 4, inputmode: "numeric",
                placeholder: t(".leave_blank_to_keep"), data: { pin_generator_target: "field" },
                class: "min-h-[48px] px-3 rounded-ctl border-2 border-line-2 font-mono text-[19px] tracking-[0.4em] flex-1" %>
          <button type="button" data-action="pin-generator#generate"
                class="min-h-[48px] px-4 rounded-ctl border-2 border-line-2 text-[14px] font-bold whitespace-nowrap active:bg-wall-2">
            <%= t(".generate_pin") %>
          </button>
        </div>
      </div>

      <div class="text-[15px] font-bold text-ink-2 pt-2 border-t border-line"><%= t(".printer_section") %></div>
      <div class="text-[14px] text-ink-3">
        <%= t(".printer_help") %>
      </div>

      <div class="flex flex-col gap-1.5">
        <%= f.label :printer_host, t(".printer_ip"), class: "text-[15px] font-semibold" %>
        <%= f.text_field :printer_host, placeholder: "192.168.1.20",
              class: "min-h-[48px] px-3 rounded-ctl border-2 border-line-2 font-mono text-[16px]" %>
      </div>

      <div class="flex flex-col gap-1.5">
        <%= f.label :printer_port, class: "text-[15px] font-semibold" %>
        <%= f.number_field :printer_port, class: "min-h-[48px] px-3 rounded-ctl border-2 border-line-2 font-mono text-[16px]" %>
      </div>

      <%= f.submit t(".save_settings"), class: "min-h-[52px] rounded-ctl text-[17px] font-bold bg-go text-surface active:bg-go-700" %>
    <% end %>
  </div>
</div>
