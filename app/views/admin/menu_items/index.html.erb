<div class="min-h-screen bg-shell p-6">
  <div class="max-w-4xl mx-auto flex flex-col gap-4">
    <div class="flex items-center justify-between">
      <h1 class="text-[26px] font-bold">Menu</h1>
      <%= link_to "Add item", new_admin_menu_item_path,
            class: "px-4 py-2.5 rounded-ctl bg-go text-surface text-[16px] font-bold" %>
    </div>

    <div class="bg-card rounded-tile border border-line overflow-x-auto">
      <table class="w-full text-[16px]">
        <thead>
          <tr class="bg-[#f2f1ec] text-left">
            <th class="px-4 py-3 font-bold">Name</th>
            <th class="px-4 py-3 font-bold">Category</th>
            <th class="px-4 py-3 font-bold">Price</th>
            <th class="px-4 py-3 font-bold">HSN/SAC</th>
            <th class="px-4 py-3 font-bold">Active</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody>
          <% @menu_items.each do |menu_item| %>
            <tr class="border-t border-line">
              <td class="px-4 py-3"><%= menu_item.name %></td>
              <td class="px-4 py-3"><%= menu_item.category %></td>
              <td class="px-4 py-3 font-mono"><%= money_to_inr(menu_item.price_paise) %></td>
              <td class="px-4 py-3 font-mono"><%= menu_item.hsn_sac %></td>
              <td class="px-4 py-3"><%= menu_item.active? ? "Yes" : "No" %></td>
              <td class="px-4 py-3 text-right whitespace-nowrap">
                <%= link_to "Edit", edit_admin_menu_item_path(menu_item), class: "text-go font-semibold mr-3" %>
                <% if menu_item.active? %>
                  <%= button_to "Deactivate", admin_menu_item_path(menu_item), method: :delete,
                        class: "px-3 py-1.5 rounded-key border-2 border-stop text-stop text-[14px] font-bold" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
