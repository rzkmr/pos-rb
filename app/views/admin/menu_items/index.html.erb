<h1>Menu</h1>

<p><%= link_to "Add item", new_admin_menu_item_path %></p>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Category</th>
      <th>Price</th>
      <th>HSN/SAC</th>
      <th>Active</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @menu_items.each do |menu_item| %>
      <tr>
        <td><%= menu_item.name %></td>
        <td><%= menu_item.category %></td>
        <td><%= money_to_inr(menu_item.price_paise) %></td>
        <td><%= menu_item.hsn_sac %></td>
        <td><%= menu_item.active? ? "Yes" : "No" %></td>
        <td>
          <%= link_to "Edit", edit_admin_menu_item_path(menu_item) %>
          <% if menu_item.active? %>
            <%= button_to "Deactivate", admin_menu_item_path(menu_item), method: :delete %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
