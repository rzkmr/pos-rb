<div class="min-h-screen bg-shell p-6">
  <div class="max-w-4xl mx-auto flex flex-col gap-4">
    <%= render "admin/shared/breadcrumb", title: t(".title") %>
    <div class="flex items-center justify-between">
      <h1 class="text-[26px] font-bold"><%= t(".title") %></h1>
      <%= link_to t(".add_user"), new_admin_user_path,
            class: "px-4 py-2.5 rounded-ctl bg-go text-surface text-[16px] font-bold" %>
    </div>

    <div class="bg-card rounded-tile border border-line overflow-x-auto">
      <table class="w-full text-[16px]">
        <thead>
          <tr class="bg-[#f2f1ec] text-left">
            <th class="px-4 py-3 font-bold"><%= t("shared.name") %></th>
            <th class="px-4 py-3 font-bold"><%= t(".role") %></th>
            <th class="px-4 py-3 font-bold"><%= t(".pin") %></th>
            <th class="px-4 py-3 font-bold"><%= t("shared.active") %></th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr class="border-t border-line">
              <td class="px-4 py-3"><%= user.name %></td>
              <td class="px-4 py-3"><%= user.role %></td>
              <td class="px-4 py-3 font-mono tracking-[0.2em]"><%= user.pin %></td>
              <td class="px-4 py-3"><%= user.active? ? t("shared.yes") : t("shared.no") %></td>
              <td class="px-4 py-3 text-right whitespace-nowrap">
                <%= link_to t("shared.edit"), edit_admin_user_path(user), class: "text-go font-semibold mr-3" %>
                <% if user.active? %>
                  <%= button_to t(".deactivate"), admin_user_path(user), method: :delete,
                        class: "px-3 py-1.5 rounded-key border-2 border-stop text-stop text-[14px] font-bold" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
