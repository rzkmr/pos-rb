<h1>Users</h1>

<p><%= link_to "Add user", new_admin_user_path %></p>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Role</th>
      <th>Active</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.name %></td>
        <td><%= user.role %></td>
        <td><%= user.active? ? "Yes" : "No" %></td>
        <td>
          <%= link_to "Edit", edit_admin_user_path(user) %>
          <% if user.active? %>
            <%= button_to "Deactivate", admin_user_path(user), method: :delete %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
