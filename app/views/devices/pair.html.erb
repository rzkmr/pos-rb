<div class="min-h-screen flex items-center justify-center bg-shell p-5">
  <div class="w-full max-w-md bg-surface rounded-phone p-6 flex flex-col gap-5">
    <h1 class="text-[22px] font-bold">Pair this device</h1>

    <% if flash[:alert] %>
      <div class="px-4 py-3 rounded-ctl bg-stop-50 border-2 border-stop text-stop text-[16px] font-semibold">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with url: devices_path, method: :post, class: "flex flex-col gap-4" do |f| %>
      <div class="flex flex-col gap-1.5">
        <%= f.label :label, "Device label", class: "text-[15px] font-semibold" %>
        <%= f.text_field :label, placeholder: "Kitchen display",
              class: "min-h-[52px] px-3 rounded-ctl border-2 border-line-2 text-[17px]" %>
      </div>
      <div class="flex flex-col gap-1.5">
        <%= f.label :kind, "Device kind", class: "text-[15px] font-semibold" %>
        <%= f.select :kind, Device::KINDS, {}, class: "min-h-[52px] px-3 rounded-ctl border-2 border-line-2 text-[17px]" %>
      </div>
      <div class="flex flex-col gap-1.5">
        <%= f.label :admin_pin, "Admin pairing PIN", class: "text-[15px] font-semibold" %>
        <%= f.password_field :admin_pin, inputmode: "numeric",
              class: "min-h-[52px] px-3 rounded-ctl border-2 border-line-2 font-mono text-[20px] tracking-[0.4em] text-center" %>
      </div>
      <%= f.submit "Pair device", class: "min-h-[60px] rounded-tile text-[18px] font-bold bg-go text-surface active:bg-go-700" %>
    <% end %>
  </div>
</div>
